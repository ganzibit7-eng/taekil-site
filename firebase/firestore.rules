rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return signedIn()
        && request.auth.token.email == 'green092432@gmail.com'
        && request.auth.token.email_verified == true;
    }

    function isOwner(uid) {
      return signedIn() && request.auth.uid == uid;
    }

    function validAttribution(a) {
      return a is map && a.keys().hasAll(['version','source','medium','campaign','content','landingPath','capturedAtMs'])
        && a.keys().hasOnly(['version','source','medium','campaign','content','landingPath','capturedAtMs'])
        && a.version == 1
        && a.source is string && a.source.size() <= 80
        && a.medium is string && a.medium.size() <= 80
        && a.campaign is string && a.campaign.size() <= 80
        && a.content is string && a.content.size() <= 80
        && a.landingPath is string && a.landingPath.matches('^/[a-zA-Z0-9/_-]{0,159}$')
        && a.capturedAtMs is number && a.capturedAtMs > 0
        && a.capturedAtMs <= request.time.toMillis() + 60000
        && a.capturedAtMs >= request.time.toMillis() - 2592000000;
    }

    match /dailySeoLanding/{entryId} {
      allow read: if isAdmin();
      allow write: if false;
    }

    match /stats/counters {
      allow read: if isAdmin();
      allow write: if false; // Validated and deduplicated by the event server.
    }

    match /dailyVisits/{dateId} {
      allow read: if isAdmin();
      allow write: if false; // Validated and deduplicated by the event server.
    }

    match /aiDailyUsage/{docId} {
      allow read, write: if false;
    }

    match /premiumUsageEvents/{docId} {
      allow read: if isAdmin();
      allow write: if false;
    }

    match /users/{uid} {
      allow read: if isAdmin() || isOwner(uid);

      allow create: if
        isOwner(uid)
        && request.resource.data.keys().hasOnly([
          'email', 'nickname', 'provider', 'createdAt', 'premium'
        ])
        && request.resource.data.premium == false;

      allow update: if
        isAdmin()
        ||
        (
          isOwner(uid)
          && request.resource.data.diff(resource.data).affectedKeys()
              .hasOnly(['email', 'nickname', 'provider', 'createdAt'])
        );

      allow delete: if isAdmin();

      match /sajuProfiles/{profileId} {
        allow read, create, update, delete: if isOwner(uid);
      }

      match /aiConversations/{conversationId} {
        allow read, create, update, delete: if isOwner(uid);
      }
    }

    match /siteSettings/checkout {
      allow get: if true;
      allow list, write: if false;
    }

    match /paymentOrders/{orderId} {
      allow create: if
        signedIn()
        && get(/databases/$(database)/documents/siteSettings/checkout).data.enabled == true
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.keys().hasOnly([
          'uid', 'amount', 'product', 'status', 'createdAt', 'attribution'
        ])
        && request.resource.data.status == 'pending'
        && request.resource.data.createdAt == request.time
        && (!request.resource.data.keys().hasAny(['attribution']) || validAttribution(request.resource.data.attribution))
        && (
          (request.resource.data.amount == 8900
            && request.resource.data.product == 'taekilso_premium_30days')
          ||
          (request.resource.data.amount == 1900
            && request.resource.data.product == 'ai_question_pack_5')
          ||
          (request.resource.data.amount == 3200
            && request.resource.data.product == 'ai_question_pack_10')
        );

      allow read: if isAdmin()
        || (signedIn() && resource.data.uid == request.auth.uid);

      allow update, delete: if false;
    }

    match /inquiries/{inquiryId} {
      allow get: if isAdmin()
        || (signedIn() && resource.data.ownerUid == request.auth.uid);

      allow list: if isAdmin()
        || (signedIn() && resource.data.ownerUid == request.auth.uid);

      allow create: if
        signedIn()
        && request.resource.data.ownerUid == request.auth.uid
        && request.resource.data.firebaseUid == request.auth.uid
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.keys().hasOnly([
          'uid', 'ownerUid', 'firebaseUid', 'name',
          'title', 'message', 'status', 'reply',
          'createdAt', 'createdAtMs', 'source'
        ])
        && request.resource.data.status == '대기'
        && request.resource.data.reply == ''
        && request.resource.data.title is string
        && request.resource.data.message is string
        && request.resource.data.title.size() > 0
        && request.resource.data.title.size() <= 120
        && request.resource.data.message.size() > 0
        && request.resource.data.message.size() <= 5000;

      allow update: if isAdmin();

      allow delete: if
        isAdmin()
        ||
        (
          signedIn()
          && resource.data.ownerUid == request.auth.uid
          && resource.data.status != '답변완료'
          && resource.data.title != '프리미엄 결제 환불 요청'
        );
    }

    match /debugLogs/{docId} {
      allow read: if isAdmin();
      allow write: if false;
    }

    match /payappTransactions/{docId} {
      allow read: if isAdmin();
      allow write: if false;
    }

    match /dailyFunnel/{dateKey} {
      allow read: if isAdmin();
      allow write: if false; // Validated and deduplicated by the event server.
    }

    match /dailyTrafficSources/{dateKey} {
      allow read: if isAdmin();
      allow write: if false; // Validated and deduplicated by the event server.
    }

    match /trafficVisitsV2/{entryId} {
      allow read: if isAdmin();
      allow write: if false; // Validated and deduplicated by the event server.
    }

    match /{document=**} {
      allow read, write: if false;
    }

  }
}
