rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    function identityHash(value) {
      return hashing.sha256(value).toHexString().lower();
    }

    function cooldownEnded(key) {
      return key == null
        || key.data.get('rejoinAllowedAtMs', key.data.get('untilMs', 0)) <= request.time.toMillis();
    }

    function identityAllowed(key) {
      // All ban writers remove their own lookup on release. Older withdrawals
      // may have only one of the two cooldown lookups.
      return !exists(/databases/$(database)/documents/memberBanKeys/$(key))
        && cooldownEnded(get(/databases/$(database)/documents/rejoinBlockKeys/$(key)))
        && cooldownEnded(get(/databases/$(database)/documents/memberRejoinKeys/$(key)));
    }

    function providerAllowed() {
      let claims = request.auth.token;
      let google = claims.get('firebase', {}).get('identities', {}).get('google.com', []);
      // Google's subject survives recreation with a new Firebase UID. Kakao
      // uses a stable kakao_<id> UID. Fall back to a verified email if needed.
      return google.size() > 0 ? identityAllowed(identityHash('provider:google.com:' + google[0]))
        : (claims.get('email_verified', false) != true || claims.get('email', '') == ''
          || identityAllowed(identityHash('email:' + claims.email.lower())));
    }

    function memberAllowed() {
      let uidKey = identityHash('uid:' + request.auth.uid);
      let sessionKey = 'SESSION-' + uidKey;
      let session = get(/databases/$(database)/documents/rejoinBlockKeys/$(sessionKey));
      return (session == null
          || request.auth.token.get('auth_time', 0) > session.data.revokedAuthTimeThrough)
        && identityAllowed(uidKey) && providerAllowed();
    }

    function isAdmin() {
      return signedIn()
        && request.auth.token.email == 'green092432@gmail.com'
        && request.auth.token.email_verified == true
        && memberAllowed();
    }

    function isOwner(uid) {
      return signedIn() && request.auth.uid == uid && memberAllowed();
    }

    match /dailyCampaignVisits/{entryId} {
      allow read: if isAdmin();
      allow write: if false;
    }

    match /dailySeoLanding/{entryId} {
      allow read: if isAdmin();
      allow write: if false;
    }

    match /stats/counters {
      allow read: if isAdmin();
      allow write: if false; // Validated and deduplicated by the event server.
    }

    match /dailyVisits/{dateId} {
      allow read: if isAdmin();
      allow write: if false; // Validated and deduplicated by the event server.
    }

    match /aiDailyUsage/{docId} {
      allow read, write: if false;
    }

    match /premiumUsageEvents/{docId} {
      allow read: if isAdmin();
      allow write: if false;
    }

    match /users/{uid} {
      allow read: if isAdmin() || isOwner(uid);

      allow create: if
        isOwner(uid)
        && request.resource.data.keys().hasOnly([
          'email', 'nickname', 'provider', 'createdAt', 'premium'
        ])
        && request.resource.data.premium == false;

      allow update: if
        (isAdmin() && !request.resource.data.diff(resource.data).affectedKeys().hasAny(['aiTransferConsent']))
        ||
        (
          isOwner(uid)
          && request.resource.data.diff(resource.data).affectedKeys()
              .hasOnly(['email', 'nickname', 'provider', 'createdAt'])
        );

      allow delete: if isAdmin();

      match /accountChecks/age14 {
        allow get: if isOwner(uid) && request.auth.token.firebase.sign_in_provider != 'anonymous';
        allow create: if isOwner(uid) && request.auth.token.firebase.sign_in_provider != 'anonymous'
          && request.resource.data.keys().hasOnly(['confirmed', 'confirmedAt'])
          && request.resource.data.confirmed == true
          && request.resource.data.confirmedAt == request.time;
      }

      match /sajuProfiles/{profileId} {
        allow read, create, update, delete: if isOwner(uid);
      }

      match /aiConversations/{conversationId} {
        allow read, create, update, delete: if isOwner(uid);
      }
    }

    match /siteSettings/checkout {
      allow get: if true;
      allow list, write: if false;
    }

    match /paymentOrders/{orderId} {
      allow create: if
        isOwner(request.resource.data.uid)
        && get(/databases/$(database)/documents/siteSettings/checkout).data.enabled == true
        && request.resource.data.keys().hasOnly([
          'uid', 'amount', 'product', 'status', 'createdAt'
        ])
        && request.resource.data.status == 'pending'
        && request.resource.data.createdAt == request.time
        && (
          (request.resource.data.amount == 1900
            && request.resource.data.product == 'ai_question_pack_5'
          )
          ||
          (request.resource.data.amount == 2500
            && request.resource.data.product == 'ai_question_pack_10'
          )
        );

      allow read: if isAdmin()
        || isOwner(resource.data.uid);

      allow update, delete: if false;
    }

    match /inquiries/{inquiryId} {
      allow get: if isAdmin()
        || isOwner(resource.data.ownerUid);

      allow list: if isAdmin()
        || isOwner(resource.data.ownerUid);

      allow create: if
        isOwner(request.resource.data.ownerUid)
        && request.resource.data.firebaseUid == request.auth.uid
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.keys().hasOnly([
          'uid', 'ownerUid', 'firebaseUid', 'name',
          'title', 'message', 'status', 'reply',
          'createdAt', 'createdAtMs', 'source'
        ])
        && request.resource.data.status == '대기'
        && request.resource.data.reply == ''
        && request.resource.data.title is string
        && request.resource.data.message is string
        && request.resource.data.title.size() > 0
        && request.resource.data.title.size() <= 120
        && request.resource.data.message.size() > 0
        && request.resource.data.message.size() <= 5000;

      allow update: if isAdmin();

      allow delete: if
        isAdmin()
        ||
        (
          isOwner(resource.data.ownerUid)
          && resource.data.status != '답변완료'
          && resource.data.get('legalHold', false) != true
          && !(resource.data.get('source', '') in ['dispute-kakao', 'dispute-firebase'])
          && resource.data.title != '프리미엄 결제 환불 요청'
        );
    }

    match /debugLogs/{docId} {
      allow read: if isAdmin();
      allow write: if false;
    }

    match /payappTransactions/{docId} {
      allow read: if isAdmin();
      allow write: if false;
    }

    match /dailyFunnel/{dateKey} {
      allow read: if isAdmin();
      allow write: if false; // Validated and deduplicated by the event server.
    }

    match /dailyTrafficSources/{dateKey} {
      allow read: if isAdmin();
      allow write: if false; // Validated and deduplicated by the event server.
    }

    match /trafficVisitsV2/{entryId} {
      allow read: if isAdmin();
      allow write: if false; // Validated and deduplicated by the event server.
    }

    match /{document=**} {
      allow read, write: if false;
    }

  }
}
