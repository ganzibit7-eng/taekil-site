<div class="admin-perm-backdrop" id="adminPermBackdrop" onclick="if(event.target===this) closeAdminPermissionModal()">
  <div class="admin-perm-modal" role="dialog" aria-modal="true" aria-labelledby="adminPermTitle">
    <div class="admin-perm-head">
      <div>
        <h3 id="adminPermTitle">회원 권한 관리</h3>
        <small id="adminPermMember">-</small>
      </div>
      <button class="admin-perm-close" type="button" onclick="closeAdminPermissionModal()" aria-label="닫기">×</button>
    </div>

    <div class="admin-perm-tabs">
      <button class="admin-perm-tab active" id="adminPermGrantTab" type="button" onclick="setAdminPermissionMode('grant')">지급</button>
      <button class="admin-perm-tab" id="adminPermRevokeTab" type="button" onclick="setAdminPermissionMode('revoke')">회수</button>
    </div>

    <div class="admin-perm-options">
      <button class="admin-perm-option active" id="adminPermPremiumOption" type="button" onclick="setAdminPermissionType('premium')">
        <b>프리미엄</b>
        <small id="adminPermPremiumDesc">30일 이용권을 지급합니다.</small>
      </button>
      <button class="admin-perm-option" id="adminPermCreditOption" type="button" onclick="setAdminPermissionType('credits')">
        <b>AI 질문권</b>
        <small id="adminPermCreditDesc">질문권을 선택한 개수만큼 지급합니다.</small>
      </button>
    </div>

    <div class="admin-perm-counts" id="adminPermCounts">
      <button class="admin-perm-count active" type="button" data-admin-count="1" onclick="setAdminPermissionCount(1)">1개</button>
      <button class="admin-perm-count" type="button" data-admin-count="5" onclick="setAdminPermissionCount(5)">5개</button>
      <button class="admin-perm-count" type="button" data-admin-count="10" onclick="setAdminPermissionCount(10)">10개</button>
      <button class="admin-perm-count" type="button" data-admin-count="all" onclick="setAdminPermissionCount('all')">전부</button>
    </div>

    <p class="admin-perm-note" id="adminPermNote">선택한 회원에게 프리미엄 30일을 지급합니다.</p>

    <div class="admin-perm-actions">
