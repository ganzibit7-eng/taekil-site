<style id="takil-v2-motion">
:root{--gold:#d7b56d;--gold2:#f1d899;--ink:#07080d;--panel:rgba(18,20,29,.72);--line:rgba(215,181,109,.18)}
html{scroll-behavior:smooth}body{background:radial-gradient(900px 500px at 50% -10%,rgba(74,61,37,.24),transparent 70%),#07080d;overflow-x:hidden}.site-bg{position:fixed;inset:0;pointer-events:none;z-index:-2;background:radial-gradient(circle at 15% 20%,rgba(215,181,109,.06),transparent 25%),radial-gradient(circle at 85% 65%,rgba(73,91,143,.08),transparent 28%)}
#starfield{position:fixed;inset:0;z-index:-1;pointer-events:none;opacity:.7}.gold-sheen{position:absolute;inset:0;pointer-events:none;background:linear-gradient(110deg,transparent 35%,rgba(255,236,181,.08) 50%,transparent 65%);transform:translateX(-120%);animation:sheen 9s ease-in-out infinite}
@keyframes sheen{0%,55%{transform:translateX(-120%)}75%,100%{transform:translateX(120%)}}@keyframes float{0%,100%{transform:translateY(0)}50%{transform:translateY(-9px)}}@keyframes pulseGlow{0%,100%{box-shadow:0 0 0 rgba(215,181,109,0)}50%{box-shadow:0 0 34px rgba(215,181,109,.16)}}
header,.header,.nav,.navbar{backdrop-filter:blur(18px);-webkit-backdrop-filter:blur(18px)}
.hero{position:relative;isolation:isolate}.hero::before{content:"";position:absolute;width:520px;height:520px;left:50%;top:8%;transform:translateX(-50%);border-radius:50%;background:radial-gradient(circle,rgba(215,181,109,.12),rgba(215,181,109,.025) 38%,transparent 70%);filter:blur(3px);z-index:-1;animation:pulseGlow 5s ease-in-out infinite}.hero::after{content:"";position:absolute;left:50%;top:10%;width:260px;height:260px;transform:translateX(-50%);border:1px solid rgba(215,181,109,.12);border-radius:50%;box-shadow:0 0 80px rgba(215,181,109,.08),inset 0 0 50px rgba(215,181,109,.04);z-index:-1;animation:float 7s ease-in-out infinite}
.hero h1,.section h2{letter-spacing:-.045em}.hero em{background:linear-gradient(135deg,var(--gold2),var(--gold));-webkit-background-clip:text;background-clip:text;color:transparent;text-shadow:0 0 32px rgba(215,181,109,.12)}
.btn-primary,.cta,.primary{position:relative;overflow:hidden}.btn-primary::before,.cta::before,.primary::before{content:"";position:absolute;inset:0;background:linear-gradient(100deg,transparent 25%,rgba(255,255,255,.25) 50%,transparent 75%);transform:translateX(-120%);transition:transform .7s}.btn-primary:hover::before,.cta:hover::before,.primary:hover::before{transform:translateX(120%)}
.card,.event-card,.feature-card,.result-card,.pricing-card,.tool-card,.home-proof{transition:transform .45s cubic-bezier(.2,.8,.2,1),border-color .45s,box-shadow .45s}.card:hover,.event-card:hover,.feature-card:hover,.result-card:hover,.pricing-card:hover,.tool-card:hover{transform:translateY(-5px);border-color:rgba(215,181,109,.35)!important;box-shadow:0 20px 70px rgba(0,0,0,.24),0 0 35px rgba(215,181,109,.06)}
.reveal{opacity:0;transform:translateY(24px);transition:opacity .8s ease,transform .8s cubic-bezier(.2,.8,.2,1)}.reveal.visible{opacity:1;transform:none}.reveal-delay-1{transition-delay:.08s}.reveal-delay-2{transition-delay:.16s}.reveal-delay-3{transition-delay:.24s}
.best-result-hero{position:relative;overflow:hidden}.best-result-hero::after{content:"";position:absolute;inset:-40%;background:conic-gradient(from 180deg,transparent,rgba(215,181,109,.08),transparent 25%);animation:spin 12s linear infinite;pointer-events:none}@keyframes spin{to{transform:rotate(360deg)}}
.score-ring{filter:drop-shadow(0 0 16px rgba(215,181,109,.18));animation:pulseGlow 4s ease-in-out infinite}.score-number{font-variant-numeric:tabular-nums}
[data-animate-count]{font-variant-numeric:tabular-nums}.magic-badge{display:inline-flex;align-items:center;gap:7px;padding:7px 11px;border:1px solid rgba(215,181,109,.2);border-radius:999px;background:rgba(215,181,109,.055);color:#e9d49e;font-size:12px}.magic-dot{width:6px;height:6px;border-radius:50%;background:var(--gold);box-shadow:0 0 12px var(--gold)}
@media(max-width:700px){.hero::before{width:340px;height:340px}.hero::after{width:190px;height:190px}.reveal{transform:translateY(16px)}.best-result-hero{border-radius:22px}}
@media(prefers-reduced-motion:reduce){*,*::before,*::after{animation-duration:.001ms!important;animation-iteration-count:1!important;scroll-behavior:auto!important;transition-duration:.001ms!important}.reveal{opacity:1;transform:none}}
</style>
<script id="takil-v2-motion-script">(function(){
  const body=document.body;
  if(!body) return;
  const bg=document.createElement('div');bg.className='site-bg';bg.innerHTML='<div class="gold-sheen"></div>';body.prepend(bg);
  // The premium theme hides the legacy starfield; do not start its animation loop.
  const targets=document.querySelectorAll('section, .event-card, .feature-card, .tool-card, .pricing-card, .home-proof, .result-card');targets.forEach((el,i)=>{el.classList.add('reveal');if(i%4===1)el.classList.add('reveal-delay-1');if(i%4===2)el.classList.add('reveal-delay-2');if(i%4===3)el.classList.add('reveal-delay-3')});
  const io=new IntersectionObserver(es=>es.forEach(e=>{if(e.isIntersecting){e.target.classList.add('visible');io.unobserve(e.target)}}),{threshold:.08,rootMargin:'0px 0px -35px'});document.querySelectorAll('.reveal').forEach(e=>io.observe(e));
  function animateCount(el){if(el.dataset.counted)return;const target=parseFloat(el.dataset.animateCount);if(!isFinite(target))return;el.dataset.counted='1';const start=performance.now(),dur=850;function tick(now){const p=Math.min(1,(now-start)/dur),ease=1-Math.pow(1-p,3);el.textContent=(target%1? (target*ease).toFixed(1):(Math.round(target*ease))).toString();if(p<1)requestAnimationFrame(tick)}requestAnimationFrame(tick)}
  const cio=new IntersectionObserver(es=>es.forEach(e=>{if(e.isIntersecting)animateCount(e.target)}),{threshold:.5});document.querySelectorAll('[data-animate-count]').forEach(e=>cio.observe(e));
  document.addEventListener('click',e=>{const a=e.target.closest('a[href^="#"]');if(!a)return;const id=a.getAttribute('href');if(id&&id.length>1){const el=document.querySelector(id);if(el){e.preventDefault();el.scrollIntoView({behavior:'smooth',block:'start'})}}});
})();</script>

<style id="takil-premium-motion">
/* =========================================================
   TAEKILSO PREMIUM MOTION SYSTEM
   CSS-only visual scenes + 3D tilt + parallax + micro motion
   ========================================================= */
:root{
  --tm-gold:#d9b66b;
  --tm-gold-hi:#ffe7a8;
  --tm-violet:#6d4bd8;
  --tm-blue:#536da8;
  --tm-bg:#07080c;
}
section.block{position:relative}
section.block::before{
  content:"";position:absolute;left:50%;top:0;width:min(72vw,980px);height:1px;
  transform:translateX(-50%);background:linear-gradient(90deg,transparent,rgba(217,182,107,.10),transparent);
  opacity:.65;
}
.hero{min-height:min(780px,88vh);display:flex;align-items:center}
.hero-inner{position:relative}
.hero-inner::before{
  content:"";position:absolute;left:50%;top:46%;width:620px;height:620px;
  transform:translate(-50%,-50%);
  background:
    radial-gradient(circle at 50% 50%,rgba(255,221,150,.11),transparent 31%),
    radial-gradient(circle at 50% 50%,rgba(104,80,190,.12),transparent 60%);
  filter:blur(8px);pointer-events:none;z-index:-1;
  animation:tmHeroBreathe 7s ease-in-out infinite;
}
@keyframes tmHeroBreathe{0%,100%{transform:translate(-50%,-50%) scale(.92);opacity:.65}50%{transform:translate(-50%,-50%) scale(1.08);opacity:1}}

.hero .eyebrow{animation:tmRise .8s .05s both}
.hero h1{animation:tmRise .9s .13s both}
.hero-copy{animation:tmRise .9s .22s both}
.hero-actions{animation:tmRise .9s .31s both}
.hero-note{animation:tmRise .9s .40s both}
@keyframes tmRise{from{opacity:0;transform:translateY(22px);filter:blur(5px)}to{opacity:1;transform:none;filter:none}}

.magic-badge{position:relative;overflow:hidden}
.magic-badge::after{
  content:"";position:absolute;top:-100%;bottom:-100%;width:45%;
  background:linear-gradient(90deg,transparent,rgba(255,239,191,.35),transparent);
  transform:translateX(-180%) skewX(-18deg);animation:tmBadgeShine 5s 1s infinite;
}
@keyframes tmBadgeShine{0%,65%{transform:translateX(-180%) skewX(-18deg)}80%,100%{transform:translateX(390%) skewX(-18deg)}}

/* Premium event cards: animated artwork header */
.event-grid{grid-template-columns:repeat(2,minmax(0,1fr));gap:18px}
.event-card{
  position:relative!important;overflow:hidden!important;padding:0!important;
  min-height:330px!important;border-radius:28px!important;
  background:linear-gradient(180deg,rgba(25,26,32,.92),rgba(12,13,18,.94))!important;
  transform-style:preserve-3d;will-change:transform;
}
.event-card::before{
  content:"";position:absolute;inset:0;z-index:1;pointer-events:none;
  background:linear-gradient(120deg,rgba(255,255,255,.08),transparent 28%,transparent 70%,rgba(217,182,107,.06));
  opacity:.45;transition:opacity .6s ease;
}
.event-card:hover::before{opacity:1}
.event-card .tm-art{
  position:relative;height:190px;overflow:hidden;
  background:#11131a;isolation:isolate;
}
.event-card .tm-art::before{
  content:"";position:absolute;inset:-12%;
  background:var(--tm-art);
  background-size:140% 140%;
  background-position:50% 50%;
  filter:saturate(.9) contrast(1.05);
  transform:scale(1.03);
  animation:tmArtDrift 12s ease-in-out infinite alternate;
  transition:transform 1.1s cubic-bezier(.2,.8,.2,1),filter .7s;
}
.event-card:hover .tm-art::before{transform:scale(1.14) translate3d(var(--mx,0px),var(--my,0px),0);filter:saturate(1.15) contrast(1.08)}
@keyframes tmArtDrift{0%{background-position:46% 44%;transform:scale(1.04)}100%{background-position:56% 55%;transform:scale(1.11)}}
.event-card .tm-art::after{
  content:"";position:absolute;inset:0;
  background:
    linear-gradient(180deg,transparent 45%,rgba(7,8,12,.78) 100%),
    radial-gradient(circle at 50% 45%,transparent 0 23%,rgba(7,8,12,.22) 58%,rgba(7,8,12,.58) 100%);
  z-index:2;
}
.event-card .tm-art .tm-art-light{
  position:absolute;width:150px;height:150px;border-radius:50%;
  left:50%;top:45%;transform:translate(-50%,-50%);
  background:radial-gradient(circle,rgba(255,227,151,.7),rgba(255,190,77,.12) 32%,transparent 70%);
  filter:blur(3px);z-index:3;mix-blend-mode:screen;
  animation:tmLightPulse 4.5s ease-in-out infinite;
}
@keyframes tmLightPulse{0%,100%{opacity:.45;transform:translate(-50%,-50%) scale(.85)}50%{opacity:.9;transform:translate(-50%,-50%) scale(1.12)}}
.event-card .tm-content{position:relative;z-index:5;padding:21px 24px 23px;text-align:left}
.event-card .tm-icon{
  width:38px;height:38px;border-radius:12px;display:grid;place-items:center;
  background:rgba(217,182,107,.10);border:1px solid rgba(217,182,107,.24);
  color:var(--tm-gold-hi);margin-bottom:12px;box-shadow:0 8px 25px rgba(0,0,0,.18);
}
.event-card .tm-icon svg{width:20px;height:20px}
.event-card h3{font-size:24px!important;margin:0 0 5px!important}
.event-card p{margin:0!important;color:rgba(255,255,255,.56)!important}
.event-card .tm-arrow{
  position:absolute;right:23px;bottom:22px;width:38px;height:38px;border-radius:50%;
  display:grid;place-items:center;border:1px solid rgba(255,255,255,.10);
  color:#fff;background:rgba(255,255,255,.045);transition:.45s cubic-bezier(.2,.8,.2,1);
}
.event-card:hover .tm-arrow{transform:translate(3px,-3px) scale(1.08);border-color:rgba(217,182,107,.4);color:var(--tm-gold-hi)}
@media(max-width:700px){.event-grid{grid-template-columns:1fr}.event-card{min-height:300px!important}.event-card .tm-art{height:165px}.event-card h3{font-size:21px!important}}

/* Four unique moving visual scenes */
.event-card:nth-child(1) .tm-art{--tm-art:
  radial-gradient(circle at 50% 38%,rgba(255,220,142,.8) 0 2%,transparent 3%),
  radial-gradient(circle at 22% 27%,rgba(242,205,129,.55) 0 1px,transparent 2px),
  radial-gradient(circle at 78% 22%,rgba(242,205,129,.6) 0 1px,transparent 2px),
  linear-gradient(145deg,rgba(81,45,118,.72),rgba(16,21,45,.95) 55%,rgba(5,9,19,1));
}
.event-card:nth-child(2) .tm-art{--tm-art:
  radial-gradient(circle at 50% 36%,rgba(255,203,104,.8) 0 2%,transparent 3%),
  linear-gradient(145deg,rgba(34,54,74,.9),rgba(15,26,35,.95) 45%,rgba(8,11,17,1));
}
.event-card:nth-child(3) .tm-art{--tm-art:
  radial-gradient(circle at 50% 35%,rgba(255,204,105,.82) 0 2%,transparent 3%),
  radial-gradient(circle at 25% 65%,rgba(108,76,194,.35),transparent 25%),
  linear-gradient(145deg,rgba(79,50,36,.82),rgba(26,22,25,.95) 50%,rgba(10,11,17,1));
}
.event-card:nth-child(4) .tm-art{--tm-art:
  radial-gradient(circle at 55% 32%,rgba(255,228,155,.75) 0 1.8%,transparent 2.7%),
  repeating-linear-gradient(25deg,rgba(217,182,107,.08) 0 1px,transparent 1px 25px),
  linear-gradient(145deg,rgba(29,49,60,.92),rgba(13,21,29,.95) 55%,rgba(7,10,15,1));
}

/* Decorative celestial rings in artwork */
.event-card .tm-orbit{position:absolute;left:50%;top:46%;width:210px;height:95px;border:1px solid rgba(242,211,146,.25);border-radius:50%;transform:translate(-50%,-50%) rotate(-18deg);z-index:3;animation:tmOrbit 9s linear infinite}
.event-card .tm-orbit::before{content:"";position:absolute;left:18%;top:-4px;width:7px;height:7px;border-radius:50%;background:#f5d58f;box-shadow:0 0 18px #f5d58f}
.event-card .tm-orbit2{position:absolute;left:50%;top:46%;width:145px;height:62px;border:1px solid rgba(255,255,255,.14);border-radius:50%;transform:translate(-50%,-50%) rotate(32deg);z-index:3;animation:tmOrbit 13s linear infinite reverse}
@keyframes tmOrbit{to{transform:translate(-50%,-50%) rotate(342deg)}}
.event-card .tm-moon{position:absolute;left:50%;top:46%;width:54px;height:54px;border-radius:50%;transform:translate(-50%,-50%);z-index:3;background:radial-gradient(circle at 35% 32%,#fff1bd,#c99649 58%,#684b24);box-shadow:0 0 38px rgba(246,207,121,.3);animation:tmMoon 5s ease-in-out infinite}
@keyframes tmMoon{0%,100%{transform:translate(-50%,-50%) scale(.94)}50%{transform:translate(-50%,-50%) scale(1.06)}}

/* Feature cards become editorial glass panels */
.features{perspective:1000px}
.feature{position:relative;overflow:hidden;transform-style:preserve-3d}
.feature::after{
  content:"";position:absolute;width:140px;height:140px;right:-60px;top:-60px;border-radius:50%;
  background:radial-gradient(circle,rgba(217,182,107,.12),transparent 68%);
  transition:transform .7s ease;pointer-events:none;
}
.feature:hover::after{transform:scale(1.7)}
.feature-num{transition:transform .5s ease,color .5s ease}.feature:hover .feature-num{transform:translateX(4px);color:var(--tm-gold-hi)}

/* Section heading reveal line */
.section-head{position:relative}
.section-head::after{
  content:"";position:absolute;left:0;bottom:-17px;width:70px;height:2px;
  background:linear-gradient(90deg,var(--tm-gold),transparent);transform-origin:left;transform:scaleX(0);
  transition:transform 1s cubic-bezier(.2,.8,.2,1) .25s;
}
.section-head.visible::after{transform:scaleX(1)}

/* Proof metrics */
.home-proof{position:relative;overflow:hidden;border-radius:18px!important}
.home-proof::before{content:"";position:absolute;inset:0;background:linear-gradient(90deg,transparent,rgba(217,182,107,.06),transparent);transform:translateX(-100%);animation:tmProof 8s ease-in-out infinite}
@keyframes tmProof{0%,55%{transform:translateX(-100%)}75%,100%{transform:translateX(100%)}}
.home-proof>div{position:relative;z-index:1}

/* Inputs: premium focus halo */
input,select,textarea{transition:border-color .3s,box-shadow .3s,transform .3s}
input:focus,select:focus,textarea:focus{border-color:rgba(217,182,107,.65)!important;box-shadow:0 0 0 4px rgba(217,182,107,.07),0 12px 35px rgba(0,0,0,.18)!important;transform:translateY(-1px)}

/* Results: reveal from depth */
.result-card{transform-style:preserve-3d}
.result-card:hover{transform:translateY(-7px) rotateX(1deg)!important}
.best-result-hero{transform-style:preserve-3d;box-shadow:0 35px 100px rgba(0,0,0,.34),0 0 80px rgba(217,182,107,.07)!important}
.best-result-hero::before{
  content:"";position:absolute;inset:-1px;border-radius:inherit;padding:1px;
  background:linear-gradient(120deg,rgba(255,231,168,.55),rgba(217,182,107,.05),rgba(112,80,190,.22),rgba(255,231,168,.28));
  -webkit-mask:linear-gradient(#000 0 0) content-box,linear-gradient(#000 0 0);
  -webkit-mask-composite:xor;mask-composite:exclude;pointer-events:none;
}

/* Floating back-to-top */
#tmTop{
  position:fixed;right:22px;bottom:24px;width:44px;height:44px;border-radius:50%;z-index:80;
  border:1px solid rgba(217,182,107,.22);background:rgba(10,11,16,.72);backdrop-filter:blur(14px);
  color:#f5dfaa;display:grid;place-items:center;opacity:0;pointer-events:none;
  transform:translateY(10px);transition:.35s ease;box-shadow:0 15px 40px rgba(0,0,0,.28)
}
#tmTop.show{opacity:1;pointer-events:auto;transform:none}
#tmTop:hover{border-color:rgba(217,182,107,.6);box-shadow:0 0 28px rgba(217,182,107,.13)}
@media(max-width:700px){#tmTop{right:14px;bottom:80px;width:40px;height:40px}}

/* Cursor glow */
#tmCursor{position:fixed;left:0;top:0;width:220px;height:220px;border-radius:50%;pointer-events:none;z-index:0;transform:translate(-50%,-50%);background:radial-gradient(circle,rgba(217,182,107,.055),transparent 65%);mix-blend-mode:screen;opacity:0;transition:opacity .3s;will-change:transform}
@media(pointer:fine){body:hover #tmCursor{opacity:1}}
@media(prefers-reduced-motion:reduce){#tmCursor{display:none}.event-card .tm-art::before,.event-card .tm-art .tm-art-light,.event-card .tm-orbit,.event-card .tm-orbit2,.event-card .tm-moon{animation:none!important}}
</style>


<script id="takil-premium-motion-script">
(function(){
  'use strict';
  const reduce = window.matchMedia && window.matchMedia('(prefers-reduced-motion: reduce)').matches;

  /* Turn the existing event cards into animated editorial cards.
     사진이 들어간 새 이벤트 카드(event-card-photo)는 이 장식 주입 대상에서 제외합니다.
     안 그러면 여기서 카드 내용을 통째로 지우고 다시 채워서, 넣어둔 캐릭터 사진이 사라집니다. */
  const cards = document.querySelectorAll('.event-card:not(.event-card-photo)');
  const icons = Array.from(cards).map(c => c.querySelector('svg'));
  cards.forEach((card,i)=>{
    const art=document.createElement('div');
    art.className='tm-art';
    art.innerHTML='<span class="tm-art-light"></span><span class="tm-orbit"></span><span class="tm-orbit2"></span><span class="tm-moon"></span>';
    const content=document.createElement('div');
    content.className='tm-content';
    const icon=document.createElement('div'); icon.className='tm-icon';
    if(icons[i]) icon.appendChild(icons[i].cloneNode(true));
    const h=card.querySelector('h3'), p=card.querySelector('p');
    if(h) content.appendChild(h);
    if(p) content.appendChild(p);
    content.insertAdjacentHTML('beforeend','<span class="tm-arrow" aria-hidden="true">↗</span>');
    card.replaceChildren(art,content);
    card.setAttribute('data-motion-card','1');
  });

  /* Add a subtle 3D tilt on desktop. */
  if(!reduce && window.matchMedia('(pointer:fine)').matches){
    document.querySelectorAll('[data-motion-card], .feature, .price-card, .best-result-hero').forEach(el=>{
      let raf=0;
      const reset=()=>{el.style.transform='';el.style.removeProperty('--mx');el.style.removeProperty('--my')};
      el.addEventListener('pointermove',e=>{
        const r=el.getBoundingClientRect();
        const x=(e.clientX-r.left)/r.width-.5, y=(e.clientY-r.top)/r.height-.5;
        cancelAnimationFrame(raf);
        raf=requestAnimationFrame(()=>{
          if(el.matches('[data-motion-card]')){
            el.style.setProperty('--mx',(x*12).toFixed(1)+'px');
            el.style.setProperty('--my',(y*8).toFixed(1)+'px');
            el.style.transform=`perspective(900px) rotateX(${(-y*3.2).toFixed(2)}deg) rotateY(${(x*4.5).toFixed(2)}deg) translateY(-6px)`;
          }else{
            el.style.transform=`perspective(1100px) rotateX(${(-y*1.7).toFixed(2)}deg) rotateY(${(x*2.4).toFixed(2)}deg) translateY(-3px)`;
          }
        });
      });
      el.addEventListener('pointerleave',reset);
    });
  }

  // The hidden legacy cursor light has no rendering loop.

  /* Add a premium top button after the page becomes long. */
  const top=document.createElement('button');top.id='tmTop';top.type='button';top.setAttribute('aria-label','맨 위로');top.innerHTML='↑';document.body.appendChild(top);
  addEventListener('scroll',()=>top.classList.toggle('show',scrollY>700),{passive:true});
  top.addEventListener('click',()=>scrollTo({top:0,behavior:reduce?'auto':'smooth'}));

  /* Scroll-linked depth for the hero light, without external libraries. */
  const hero=document.querySelector('.hero-inner');
  if(hero && !reduce){
    addEventListener('scroll',()=>{
      const y=Math.min(scrollY,700);
      hero.style.transform=`translate3d(0,${y*.035}px,0)`;
    },{passive:true});
  }

  /* Observe dynamically inserted result cards too. */
  const revealObserver=new IntersectionObserver(entries=>{
    entries.forEach(e=>{
      if(e.isIntersecting){e.target.classList.add('visible');revealObserver.unobserve(e.target)}
    });
  },{threshold:.08,rootMargin:'0px 0px -30px'});
  const observeResults=()=>{
    document.querySelectorAll('.result-card:not(.visible), .best-result-hero:not(.visible)').forEach(el=>{
      el.classList.add('reveal');revealObserver.observe(el);
    });
  };
  observeResults();
  const mo=new MutationObserver(observeResults);
  mo.observe(document.body,{subtree:true,childList:true});
})();
</script>


<style id="takil-ultra-ui">
/* =========================================================
   TAKILSO ULTRA EDITORIAL UI
   A CSS-only cinematic layer for GitHub Pages.
   ========================================================= */
:root{
  --ultra-gold:#e7c77d;
  --ultra-gold2:#9d7637;
  --ultra-purple:#2b1645;
  --ultra-ink:#070707;
}
body{overflow-x:hidden}

/* Ambient particles / aurora */
#ultraAmbient{position:fixed;inset:0;pointer-events:none;z-index:-1;overflow:hidden;background:radial-gradient(900px 520px at 50% 6%,rgba(79,49,118,.12),transparent 65%)}
#ultraAmbient:before,#ultraAmbient:after{content:"";position:absolute;border-radius:50%;filter:blur(55px);opacity:.28;animation:ultraFloat 15s ease-in-out infinite alternate}
#ultraAmbient:before{width:430px;height:430px;left:-170px;top:30vh;background:rgba(83,49,132,.22)}
#ultraAmbient:after{width:520px;height:520px;right:-220px;top:65vh;background:rgba(213,170,81,.12);animation-delay:-7s}
@keyframes ultraFloat{from{transform:translate3d(0,0,0) scale(1)}to{transform:translate3d(45px,-35px,0) scale(1.12)}}

/* Cinematic hero */
.hero{min-height:820px;background:radial-gradient(ellipse at 50% 48%,rgba(50,30,78,.17),transparent 48%)}
.hero:before{width:760px;height:760px;right:50%;top:35%;transform:translate(50%,-50%);border-color:rgba(231,199,125,.09);animation:heroOrbit 22s linear infinite}
.hero:after{height:420px;opacity:.7;animation:heroLine 4s ease-in-out infinite}
@keyframes heroOrbit{to{transform:translate(50%,-50%) rotate(360deg)}}
@keyframes heroLine{0%,100%{opacity:.2}50%{opacity:.8}}
.hero-inner:before{content:"";position:absolute;z-index:-1;width:430px;height:430px;left:50%;top:42%;transform:translate(-50%,-50%);border-radius:50%;background:radial-gradient(circle,rgba(231,199,125,.11),rgba(91,57,132,.05) 35%,transparent 70%);filter:blur(4px);animation:heroGlow 5s ease-in-out infinite}
@keyframes heroGlow{0%,100%{transform:translate(-50%,-50%) scale(.9);opacity:.55}50%{transform:translate(-50%,-50%) scale(1.12);opacity:1}}
.hero h1{position:relative;text-shadow:0 8px 55px rgba(0,0,0,.55)}
.hero h1 em{background:linear-gradient(120deg,#fff5d6 0%,#e7c77d 38%,#a97e39 75%,#fff0c4 100%);-webkit-background-clip:text;background-clip:text;color:transparent;background-size:220% 100%;animation:textGold 7s ease-in-out infinite}
@keyframes textGold{0%,100%{background-position:0% 50%}50%{background-position:100% 50%}}

/* floating celestial seal */
.ultra-seal{position:absolute;left:50%;top:47%;width:420px;height:420px;transform:translate(-50%,-50%);pointer-events:none;opacity:.72}
.ultra-seal .ring{position:absolute;inset:0;border:1px solid rgba(231,199,125,.10);border-radius:50%;box-shadow:0 0 55px rgba(231,199,125,.05),inset 0 0 55px rgba(90,56,130,.04);animation:sealSpin 26s linear infinite}
.ultra-seal .ring:nth-child(2){inset:12%;border-style:dashed;animation-duration:34s;animation-direction:reverse}
.ultra-seal .ring:nth-child(3){inset:29%;border-color:rgba(231,199,125,.17);animation-duration:18s}
.ultra-seal .core{position:absolute;inset:40%;border-radius:50%;background:radial-gradient(circle at 35% 30%,#fff2bf,rgba(231,199,125,.35) 22%,rgba(92,55,130,.18) 48%,transparent 72%);filter:blur(.2px);animation:corePulse 4s ease-in-out infinite}
.ultra-seal .dot{position:absolute;width:5px;height:5px;border-radius:50%;background:#f4d98e;box-shadow:0 0 15px #e7c77d;left:50%;top:2%;transform-origin:0 198px;animation:dotOrbit 7s linear infinite}
@keyframes sealSpin{to{transform:rotate(360deg)}}
@keyframes corePulse{0%,100%{transform:scale(.8);opacity:.55}50%{transform:scale(1.25);opacity:1}}
@keyframes dotOrbit{to{transform:rotate(360deg)}}

/* Hero micro chips */
.hero-note{position:relative;z-index:3}.magic-badge{display:inline-flex;align-items:center;gap:7px;margin-top:10px;padding:7px 12px;border:1px solid rgba(231,199,125,.16);border-radius:999px;background:rgba(231,199,125,.035);color:#aaa18f;box-shadow:0 10px 40px rgba(0,0,0,.15)}
.magic-dot{width:5px;height:5px;border-radius:50%;background:var(--ultra-gold);box-shadow:0 0 13px var(--ultra-gold);animation:dotPulse 1.7s ease-in-out infinite}
@keyframes dotPulse{50%{transform:scale(1.7);opacity:.5}}

/* Event showcase: 2-up editorial cards like a premium fortune platform */
.event-grid{grid-template-columns:repeat(2,minmax(0,1fr));gap:18px}
.event-card{padding:0!important;min-height:0!important;border-radius:30px!important;overflow:hidden!important;background:#111!important;border:1px solid rgba(255,255,255,.12)!important;box-shadow:0 25px 90px rgba(0,0,0,.25);transition:transform .65s cubic-bezier(.16,1,.3,1),border-color .45s,box-shadow .65s!important}
.event-card:hover{border-color:rgba(231,199,125,.45)!important;box-shadow:0 35px 110px rgba(0,0,0,.45),0 0 50px rgba(231,199,125,.06)!important}
.event-card .tm-art{height:255px!important;background:#0d0c0d!important}
.event-card .tm-art:before{animation:ultraScene 14s ease-in-out infinite alternate!important;background-size:115% 115%!important}
.event-card .tm-art:after{background:linear-gradient(180deg,rgba(5,5,7,.02) 35%,rgba(7,7,9,.72) 100%),radial-gradient(circle at 50% 35%,transparent 0 28%,rgba(5,5,7,.34) 82%)!important}
@keyframes ultraScene{0%{transform:scale(1.02) translate3d(-1%,0,0);background-position:45% 46%}100%{transform:scale(1.12) translate3d(2%,-1.5%,0);background-position:58% 54%}}
.event-card .tm-content{min-height:205px;padding:28px 30px 30px!important;background:linear-gradient(180deg,rgba(31,17,48,.98),rgba(21,13,32,.98))}
.event-card:nth-child(even) .tm-content{background:linear-gradient(180deg,#292929,#222)}
.event-card .tm-icon{width:42px;height:42px;border-radius:50%;margin-bottom:20px!important;background:rgba(231,199,125,.08);border-color:rgba(231,199,125,.24);box-shadow:0 0 30px rgba(231,199,125,.05)}
.event-card h3{font-family:var(--serif)!important;font-size:30px!important;font-weight:500!important;letter-spacing:-.04em!important}
.event-card p{font-size:14px!important;color:rgba(255,255,255,.58)!important;line-height:1.65}
.event-card .tm-arrow{width:44px;height:44px;right:28px;bottom:29px}
.event-card .tm-art-light{width:230px!important;height:230px!important;animation:sceneLight 5s ease-in-out infinite!important}
@keyframes sceneLight{0%,100%{opacity:.28;transform:translate(-50%,-50%) scale(.78)}50%{opacity:.8;transform:translate(-47%,-53%) scale(1.22)}}

/* scene layers */
.ultra-scene{position:absolute;inset:0;z-index:4;pointer-events:none;overflow:hidden}
.scene-stars{position:absolute;inset:0;background-image:radial-gradient(circle at 18% 24%,rgba(255,232,165,.8) 0 1px,transparent 2px),radial-gradient(circle at 78% 19%,rgba(255,232,165,.8) 0 1px,transparent 2px),radial-gradient(circle at 62% 38%,rgba(255,232,165,.55) 0 1px,transparent 2px),radial-gradient(circle at 31% 57%,rgba(255,232,165,.55) 0 1px,transparent 2px);animation:starsDrift 8s ease-in-out infinite alternate}
@keyframes starsDrift{to{transform:translate3d(9px,-7px,0);opacity:.65}}
.scene-moon{position:absolute;width:74px;height:74px;right:17%;top:16%;border-radius:50%;background:radial-gradient(circle at 35% 32%,#fff8dc,#d7b46a 48%,#6e4b21 100%);box-shadow:0 0 35px rgba(231,199,125,.34);animation:moonFloat 7s ease-in-out infinite}
.scene-moon:after{content:"";position:absolute;inset:13px;border-radius:50%;background:rgba(67,43,29,.16);box-shadow:15px -8px 0 rgba(67,43,29,.10),-10px 15px 0 rgba(67,43,29,.08)}
@keyframes moonFloat{50%{transform:translate3d(-5px,8px,0)}}
.scene-gate{position:absolute;left:50%;bottom:-8px;width:190px;height:122px;transform:translateX(-50%);border:3px solid rgba(210,167,92,.55);border-bottom:0;border-radius:95px 95px 0 0;box-shadow:0 0 35px rgba(231,199,125,.10);animation:gateBreath 5s ease-in-out infinite}
.scene-gate:after{content:"";position:absolute;left:50%;top:28px;bottom:0;width:72px;transform:translateX(-50%);background:linear-gradient(90deg,#24150d,#9a642e 45%,#2b180f);border:1px solid rgba(231,199,125,.3)}
@keyframes gateBreath{50%{transform:translateX(-50%) scale(1.035);filter:brightness(1.12)}}
.scene-sun{position:absolute;width:120px;height:120px;left:50%;top:37%;transform:translate(-50%,-50%);border-radius:50%;background:radial-gradient(circle,#fff0b6 0 7%,rgba(231,199,125,.65) 15%,rgba(231,199,125,.12) 44%,transparent 70%);animation:sunPulse 4.5s ease-in-out infinite}
@keyframes sunPulse{50%{transform:translate(-50%,-50%) scale(1.18);opacity:.82}}
.scene-path{position:absolute;left:50%;bottom:-28px;width:260px;height:145px;transform:translateX(-50%);border-radius:50%;border:2px solid rgba(231,199,125,.25);box-shadow:0 0 30px rgba(231,199,125,.07),inset 0 0 30px rgba(231,199,125,.05);animation:pathPulse 5s ease-in-out infinite}
@keyframes pathPulse{50%{transform:translateX(-50%) scaleX(1.08);opacity:.7}}
.scene-flare{position:absolute;width:280px;height:2px;left:-20%;top:36%;background:linear-gradient(90deg,transparent,rgba(255,238,181,.9),transparent);filter:blur(.5px);transform:rotate(-12deg);animation:flareMove 6s linear infinite}
@keyframes flareMove{to{left:120%;top:62%}}

/* Feature cards become cinematic */
.feature{overflow:hidden}
.feature:before{content:"";position:absolute;width:1px;height:130px;right:24px;top:20px;background:linear-gradient(transparent,rgba(231,199,125,.45),transparent);animation:featureBeam 4s ease-in-out infinite}
@keyframes featureBeam{50%{transform:translateY(65px);opacity:.25}}

/* Process timeline */
.steps{position:relative}
.steps:before{content:"";position:absolute;left:0;right:0;top:31px;height:1px;background:linear-gradient(90deg,transparent,rgba(231,199,125,.28),transparent)}
.step{position:relative;z-index:1}
.step-no{display:inline-flex;padding:7px 10px;border:1px solid rgba(231,199,125,.18);border-radius:999px;background:#080807}
.step h3{margin-top:35px}

/* Tool shell premium glass */
.tool-shell{position:relative;overflow:hidden}
.tool-shell:before{content:"";position:absolute;inset:-50%;background:conic-gradient(from 0deg,transparent 0 78%,rgba(231,199,125,.07) 82%,transparent 86%);animation:toolSpin 18s linear infinite;pointer-events:none}
.tool-shell>*{position:relative;z-index:1}
@keyframes toolSpin{to{transform:rotate(360deg)}}

/* Result hero */
.best-result-hero{position:relative;overflow:hidden;border-radius:34px!important;background:radial-gradient(circle at 50% 0%,rgba(231,199,125,.13),transparent 40%),linear-gradient(145deg,#21132f,#0e0e0e 70%)!important;border:1px solid rgba(231,199,125,.35)!important;box-shadow:0 35px 110px rgba(0,0,0,.42),0 0 80px rgba(231,199,125,.06)}
.best-result-hero:before{content:"";position:absolute;width:360px;height:360px;right:-130px;top:-150px;border:1px solid rgba(231,199,125,.18);border-radius:50%;box-shadow:0 0 0 45px rgba(231,199,125,.025),0 0 0 90px rgba(231,199,125,.015);animation:sealSpin 24s linear infinite}

/* Scroll reveal */
.reveal{opacity:0;transform:translateY(28px);transition:opacity .9s cubic-bezier(.2,.8,.2,1),transform .9s cubic-bezier(.2,.8,.2,1)}
.reveal.visible{opacity:1;transform:none}
.event-card{animation:cardIn .9s both}
.event-card:nth-child(2){animation-delay:.08s}.event-card:nth-child(3){animation-delay:.16s}.event-card:nth-child(4){animation-delay:.24s}
@keyframes cardIn{from{opacity:0;transform:translateY(28px) scale(.985)}to{opacity:1;transform:none}}

@media(max-width:900px){
  .event-grid{grid-template-columns:1fr 1fr}
  .event-card .tm-art{height:220px!important}
  .ultra-seal{width:320px;height:320px}
}
@media(max-width:700px){
  .hero{min-height:720px;padding-top:100px}
  .hero-inner:before{width:310px;height:310px}
  .ultra-seal{width:260px;height:260px;top:44%}
  .event-grid{grid-template-columns:1fr;gap:14px}
  .event-card .tm-art{height:205px!important}
  .event-card .tm-content{min-height:180px;padding:24px!important}
  .event-card h3{font-size:27px!important}
  .steps:before{display:none}
}
@media(prefers-reduced-motion:reduce){
  #ultraAmbient,.ultra-seal,.hero:before,.hero:after,.hero-inner:before,.hero h1 em,.scene-stars,.scene-moon,.scene-gate,.scene-sun,.scene-path,.scene-flare,.feature:before,.tool-shell:before,.best-result-hero:before,.event-card{animation:none!important}
  .reveal{opacity:1!important;transform:none!important}
}
</style>

<script id="takil-ultra-motion">
(function(){
  const reduce=window.matchMedia&&window.matchMedia('(prefers-reduced-motion: reduce)').matches;
  const ambient=document.createElement('div');ambient.id='ultraAmbient';document.body.prepend(ambient);

  /* Put a celestial seal behind the hero text. */
  document.querySelectorAll('.hero:not(.hero-sm) .hero-inner').forEach(hero=>{
    if(hero.querySelector('.ultra-seal')) return;
    const seal=document.createElement('div');seal.className='ultra-seal';
    seal.innerHTML='<span class="ring"></span><span class="ring"></span><span class="ring"></span><span class="core"></span><span class="dot"></span>';
    hero.prepend(seal);
  });

  /* Make each event card a living scene. */
  document.querySelectorAll('.event-card .tm-art').forEach((art,i)=>{
    if(art.querySelector('.ultra-scene')) return;
    const scene=document.createElement('div');scene.className='ultra-scene';
    if(i===0) scene.innerHTML='<span class="scene-stars"></span><span class="scene-moon"></span><span class="scene-sun"></span><span class="scene-flare"></span>';
    if(i===1) scene.innerHTML='<span class="scene-stars"></span><span class="scene-moon"></span><span class="scene-gate"></span><span class="scene-path"></span><span class="scene-flare"></span>';
    if(i===2) scene.innerHTML='<span class="scene-stars"></span><span class="scene-sun"></span><span class="scene-path"></span><span class="scene-flare"></span>';
    if(i===3) scene.innerHTML='<span class="scene-stars"></span><span class="scene-moon"></span><span class="scene-gate"></span><span class="scene-flare"></span>';
    art.appendChild(scene);
  });

  /* Cursor parallax for the hero and editorial cards. */
  if(!reduce && matchMedia('(pointer:fine)').matches){
    const targets=[...document.querySelectorAll('.event-card,.feature,.price-card,.tool-shell,.best-result-hero')];
    targets.forEach(el=>{
      let raf=0;
      el.addEventListener('pointermove',e=>{
        const r=el.getBoundingClientRect();const x=e.clientX/r.width-r.left/r.width-.5;const y=e.clientY/r.height-r.top/r.height-.5;
        cancelAnimationFrame(raf);raf=requestAnimationFrame(()=>{
          el.style.setProperty('--tiltX',(-y*2.8).toFixed(2)+'deg');
          el.style.setProperty('--tiltY',(x*3.6).toFixed(2)+'deg');
          if(el.classList.contains('event-card')) el.style.transform=`perspective(1200px) rotateX(var(--tiltX)) rotateY(var(--tiltY)) translateY(-8px)`;
        });
      });
      el.addEventListener('pointerleave',()=>{el.style.transform='';});
    });
  }

  /* Progressive reveal for all major blocks. */
  if('IntersectionObserver' in window){
    const io=new IntersectionObserver(entries=>entries.forEach(e=>{if(e.isIntersecting){e.target.classList.add('visible');io.unobserve(e.target)}}),{threshold:.08,rootMargin:'0px 0px -40px'});
    document.querySelectorAll('.feature,.step,.price-card,.faq-item,.usecase-item,.home-proof,.section-head').forEach(el=>{el.classList.add('reveal');io.observe(el)});
  }
})();
</script>


<script id="takil-premium-final-hooks">
window.addEventListener('load', ()=>{ try{ updatePremiumUI(); }catch(e){} });
</script>
