
<style id="taekilso-v3-upgrade">
/* 2026 customer-demand upgrade */
.fortune-grid{
  display:grid;grid-template-columns:repeat(3,1fr);gap:14px;
}
.fortune-card{
  min-height:225px;padding:25px 23px;text-align:left;border:1px solid var(--line-soft);
  border-radius:22px;background:linear-gradient(145deg,#12100c,#0c0b09);
  color:var(--white);display:flex;flex-direction:column;align-items:flex-start;
  transition:.35s var(--ease);position:relative;overflow:hidden;
}
.fortune-card:hover{transform:translateY(-5px);border-color:rgba(215,180,106,.35);box-shadow:0 18px 55px rgba(0,0,0,.22)}
.fortune-card:after{content:"";position:absolute;width:150px;height:150px;border-radius:50%;right:-80px;bottom:-90px;background:rgba(215,180,106,.07)}
.fortune-feature{border-color:rgba(215,180,106,.35);background:linear-gradient(145deg,rgba(215,180,106,.12),#0c0b09)}
.fortune-icon{font-family:"Noto Serif KR",serif;font-size:27px;color:var(--gold-hi);margin-bottom:19px}
.fortune-kicker{font-size:9px;letter-spacing:.17em;color:var(--gold);font-weight:800;margin-bottom:9px}
.fortune-card strong{font-family:"Noto Serif KR",serif;font-size:19px;font-weight:600}
.fortune-card small{margin-top:10px;color:var(--muted);font-size:12px;line-height:1.75;max-width:260px}
.fortune-card b{margin-top:auto;padding-top:17px;color:var(--gold-hi);font-size:11px}
.fortune-note{
  display:grid;grid-template-columns:1fr 1fr;gap:1px;margin-top:16px;
  border:1px solid var(--line-soft);border-radius:18px;overflow:hidden;background:var(--line-soft)
}
.fortune-note>div{padding:20px;background:rgba(255,255,255,.025)}
.fortune-note strong{display:block;font-family:"Noto Serif KR",serif;font-size:14px;color:#e7dfcf;margin-bottom:7px}
.fortune-note span{display:block;color:var(--muted);font-size:11.5px;line-height:1.75}
.fortune-modal{
  display:none;position:fixed;inset:0;z-index:160;align-items:center;justify-content:center;padding:18px;
  background:rgba(0,0,0,.78);backdrop-filter:blur(18px)
}
.fortune-modal.show{display:flex}
.fortune-box{
  width:min(560px,100%);max-height:min(88vh,760px);overflow:auto;padding:28px;
  border:1px solid rgba(215,180,106,.28);border-radius:28px;background:#100f0c;
  box-shadow:0 35px 100px rgba(0,0,0,.65)
}
.fortune-box h3{font-family:"Noto Serif KR",serif;font-size:27px;font-weight:600;margin:0 0 7px}
.fortune-box .sub{font-size:12px;color:var(--muted);line-height:1.7;margin:0 0 20px}
.fortune-result{margin-top:18px;padding:20px;border-radius:20px;border:1px solid rgba(215,180,106,.24);background:rgba(215,180,106,.06)}
.fortune-result .fr-head{display:flex;justify-content:space-between;gap:15px;align-items:flex-start}
.fortune-result .fr-title{font-family:"Noto Serif KR",serif;font-size:21px}
.fortune-result .fr-score{font-size:25px;font-weight:850;color:var(--gold-hi)}
.fortune-result p{color:#d3cec3;font-size:13px;line-height:1.85;margin:15px 0 0}
.fortune-close{float:right;border:0;background:none;color:var(--muted);font-size:20px}
.service-badge{
  display:inline-flex;gap:7px;align-items:center;margin-top:15px;padding:7px 10px;border-radius:999px;
  border:1px solid rgba(215,180,106,.18);background:rgba(215,180,106,.05);font-size:10px;color:var(--gold-hi)
}
@media(max-width:820px){
  .fortune-grid{grid-template-columns:1fr 1fr}
  .fortune-note{grid-template-columns:1fr}
}
@media(max-width:520px){
  .fortune-grid{grid-template-columns:1fr}
  .fortune-card{min-height:195px}
  .fortune-box{padding:22px 16px}
}

/* ---- 모바일에서 "글씨 + 카드 결혼일 찾기"까지 스크롤 없이 한 화면에 보이도록 압축 (살짝 여유 추가) ---- */
@media(max-width:640px){
  .hero.hero-carousel{min-height:auto!important; padding-top:22px!important; padding-bottom:0!important}
  .hero.hero-carousel .hero-inner{padding:0 20px}
  .hero.hero-carousel .eyebrow{font-size:11px; margin-bottom:8px}
  .hero.hero-carousel h1{font-size:25px; line-height:1.34; margin:0 0 11px}
  .hero.hero-carousel .hero-copy{font-size:13px; line-height:1.55; margin:0}
  #eventsAnchor{padding-top:0!important}
  .event-carousel-track{padding:14px 16px 22px; gap:12px}
  .event-card-v3{width:66vw; border-radius:20px}
  .event-card-v3 img{aspect-ratio:3/2.9; object-position:top center}
  .event-card-v3-badge{width:34px; height:34px; font-size:14px; top:14px; left:14px}
  .event-card-v3-info{padding:16px 17px 18px}
  .event-card-v3-info small{font-size:10px}
  .event-card-v3-info h3{font-size:17px; margin:5px 0 6px}
  .event-card-v3-info p{font-size:11.5px; line-height:1.5; margin:0 0 9px}
  .event-card-v3-info b{font-size:12px}
  /* 사주/기록 페이지 등 작은 히어로(hero-sm)도 홈과 비슷하게 위쪽 여백을 좁힙니다. */
  .hero.hero-sm{padding-top:44px!important; padding-bottom:26px!important}
}
</style>



<style id="home-ai-arrow-only-style">
#view-home > .home-first-block{
  position:relative;
}
#view-home > .home-first-block .home-ai-arrow-only{
  position:absolute;
  left:50%;
  bottom:18px;
  transform:translateX(-50%);
  z-index:12;
  display:flex;
  align-items:center;
  justify-content:center;
  width:52px;
  height:42px;
  margin:0;
  padding:0;
  border:0;
  background:transparent;
  cursor:pointer;
  -webkit-tap-highlight-color:transparent;
}
.home-ai-arrow-only .home-more-chevrons{
  position:relative;
  display:block;
  width:28px;
  height:25px;
  animation:homeMoreFloat 1.7s ease-in-out infinite;
}
.home-ai-arrow-only .home-more-chevrons i{
  position:absolute;
  left:50%;
  width:17px;
  height:17px;
  border-right:2px solid rgba(203,196,184,.68);
  border-bottom:2px solid rgba(203,196,184,.68);
  transform:translateX(-50%) rotate(45deg);
}
.home-ai-arrow-only .home-more-chevrons i:first-child{top:-3px;opacity:.48;}
.home-ai-arrow-only .home-more-chevrons i:last-child{top:6px;opacity:.9;}

@media(max-width:640px){
  #view-home > .home-first-block .home-ai-arrow-only{
    bottom:max(12px, env(safe-area-inset-bottom));
  }
}

@media(prefers-reduced-motion:reduce){
  .home-ai-arrow-only .home-more-chevrons{animation:none;}
}
</style>


<style id="admin-ban-section-visible-style">
.admin-ban-section{
  margin-top:28px;
  padding:18px;
  border:1px solid rgba(215,180,106,.22);
  border-radius:18px;
  background:rgba(215,180,106,.035);
}
.admin-ban-head{
  display:flex;
  align-items:center;
  justify-content:space-between;
  gap:12px;
}
.admin-ban-refresh{
  border:1px solid rgba(255,255,255,.12);
  border-radius:999px;
  padding:8px 12px;
  background:rgba(255,255,255,.04);
  color:var(--muted);
  font-size:11px;
  cursor:pointer;
}
.admin-ban-refresh:hover{
  border-color:rgba(215,180,106,.35);
  color:var(--gold-hi);
}
</style>


<style id="self-delete-cooldown-style">
.pf-danger-note{
  margin-top:18px;
  padding:11px 12px;
  border:1px solid rgba(220,135,110,.18);
  border-radius:12px;
  background:rgba(220,135,110,.045);
  color:#bdb4aa;
  font-size:11px;
  line-height:1.65;
}
</style>

<style id="home-section-bidirectional-arrows">
.home-arrow-section{position:relative;}
.home-section-nav{position:absolute;inset:0;pointer-events:none;z-index:10;}
.home-section-arrow{
  position:absolute;left:50%;transform:translateX(-50%);
  width:48px;height:40px;padding:0;border:0;background:transparent;
  display:flex;align-items:center;justify-content:center;
  pointer-events:auto;cursor:pointer;-webkit-tap-highlight-color:transparent;
}
.home-section-arrow-up{top:18px;}
.home-section-arrow-down{bottom:18px;}
.home-section-arrow span{
  display:block;width:16px;height:16px;
  border-right:2px solid rgba(203,196,184,.78);
  border-bottom:2px solid rgba(203,196,184,.78);
}
.home-section-arrow-down span{transform:rotate(45deg);}
.home-section-arrow-up span{transform:rotate(225deg);}
@media(max-width:640px){
  .home-section-arrow-up{top:max(12px,env(safe-area-inset-top));}
  .home-section-arrow-down{bottom:max(12px,env(safe-area-inset-bottom));}
}
</style>


<style id="home-growth-features">
.home-daily-yeonwoo,.home-free-report-card,.home-consult-to-date{
  margin-top:18px;padding:18px;border:1px solid rgba(215,180,106,.16);
  border-radius:18px;background:rgba(255,255,255,.025);
}
.home-feature-kicker{font-size:9px;letter-spacing:.18em;color:var(--gold);margin-bottom:9px;}
.home-daily-yeonwoo strong,.home-consult-to-date strong{
  display:block;font-family:var(--serif);font-size:17px;font-weight:400;line-height:1.45;color:var(--white);
}
.home-daily-yeonwoo p,.home-free-report-card p,.home-consult-to-date p{
  margin:8px 0 13px;color:var(--muted);font-size:11px;line-height:1.65;
}
.home-daily-yeonwoo>button,.home-free-report-card>button{
  width:100%;border:1px solid rgba(215,180,106,.18);border-radius:12px;
  padding:11px 12px;background:rgba(215,180,106,.06);color:var(--gold-hi);
  font:inherit;font-size:11px;text-align:left;cursor:pointer;
}
.home-daily-yeonwoo>button i,.home-free-report-card>button i{float:right;font-style:normal;}
.home-free-report-card h3{margin:0;font-family:var(--serif);font-size:20px;font-weight:400;}
.home-report-tags{display:flex;flex-wrap:wrap;gap:6px;margin:0 0 13px;}
.home-report-tags span{padding:5px 8px;border-radius:999px;background:rgba(255,255,255,.045);font-size:9.5px;color:var(--muted);}
.home-date-actions{display:grid;grid-template-columns:1fr 1fr;gap:7px;}
.home-date-actions button{
  border:1px solid rgba(255,255,255,.08);border-radius:11px;padding:10px 8px;
  background:rgba(255,255,255,.025);color:var(--muted);font:inherit;font-size:10.5px;cursor:pointer;
}
</style>


<script type="application/ld+json" id="taekilso-service-schema">
{
  "@context":"https://schema.org",
  "@type":"WebSite",
  "name":"택일소",
  "url":"https://taekilso.com/",
  "description":"AI 사주 상담, 사주 궁합, 결혼·이사·개업·계약 택일을 제공하는 서비스",
  "potentialAction":{
    "@type":"SearchAction",
    "target":"https://taekilso.com/?q={search_term_string}",
    "query-input":"required name=search_term_string"
  }
}
</script>
<script type="application/ld+json" id="taekilso-service-offer-schema">
{
  "@context":"https://schema.org",
  "@type":"Service",
  "name":"택일소 AI 사주 상담 및 택일",
  "provider":{"@type":"Organization","name":"택일소"},
  "areaServed":"KR",
  "serviceType":["AI 사주 상담","사주 궁합","결혼 택일","이사 택일","개업일 택일","계약일 택일"],
  "url":"https://taekilso.com/"
}
</script>


<style id="conversion-seo-expansion-style">
.ai-next-actions{margin-top:12px;padding-top:10px;border-top:1px solid rgba(255,255,255,.07);display:flex;flex-wrap:wrap;gap:7px;}
.ai-next-actions-title{width:100%;font-size:9.5px;color:var(--muted-2);margin-bottom:2px;}
.ai-next-actions button{border:1px solid rgba(215,180,106,.16);border-radius:999px;padding:7px 10px;background:rgba(215,180,106,.05);color:var(--gold-hi);font:inherit;font-size:9.8px;cursor:pointer;}
.home-compat-teaser{margin-top:18px;padding:18px;border:1px solid rgba(215,180,106,.16);border-radius:18px;background:rgba(255,255,255,.025);}
.home-compat-teaser h3{margin:0;font-family:var(--serif);font-size:20px;line-height:1.45;font-weight:400;}
.home-compat-teaser p{margin:8px 0 13px;color:var(--muted);font-size:11px;line-height:1.65;}
.home-compat-points{display:flex;gap:6px;flex-wrap:wrap;margin-bottom:13px;}
.home-compat-points span{padding:5px 8px;border-radius:999px;background:rgba(255,255,255,.045);font-size:9.5px;color:var(--muted);}
.home-compat-teaser>button{width:100%;border:1px solid rgba(215,180,106,.18);border-radius:12px;padding:11px 12px;background:rgba(215,180,106,.06);color:var(--gold-hi);font:inherit;font-size:11px;text-align:left;cursor:pointer;}
.home-compat-teaser>button i{float:right;font-style:normal;}
.seo-landing-block{padding:74px 0;border-top:1px solid rgba(255,255,255,.055);}
.seo-landing-block p{margin:14px 0 16px;color:var(--muted);font-size:13px;line-height:1.9;}
.seo-landing-block a{color:var(--gold-hi);font-size:12px;text-decoration:none;border-bottom:1px solid rgba(215,180,106,.28);padding-bottom:3px;}
@media(max-width:640px){
  .seo-landing-block{padding:54px 0;}
}
</style>


<style id="ai-answer-share-style">
.ai-answer-sharebar{display:flex;justify-content:flex-end;margin-top:9px;}
.ai-answer-sharebtn{
  border:0;background:transparent;color:var(--muted-2);font:inherit;font-size:9.8px;
  padding:5px 0;cursor:pointer;
}
.ai-answer-sharebtn:hover{color:var(--gold-hi);}
.ai-share-modal{
  position:fixed;inset:0;z-index:99999;background:rgba(0,0,0,.78);
  display:none;align-items:center;justify-content:center;padding:18px;
}
.ai-share-modal.show{display:flex;}
.ai-share-panel{width:min(420px,100%);background:#11110f;border:1px solid rgba(215,180,106,.2);border-radius:20px;padding:16px;}
.ai-share-card{
  position:relative;overflow:hidden;aspect-ratio:4/5;border-radius:18px;padding:28px 24px;
  background:linear-gradient(155deg,#171510,#090908 65%,#16120c);border:1px solid rgba(215,180,106,.18);
  display:flex;flex-direction:column;
}
.ai-share-brand{font-family:var(--serif);font-size:13px;color:var(--gold-hi);letter-spacing:.16em;}
.ai-share-sub{font-size:9px;color:var(--muted-2);margin-top:5px;}
.ai-share-answer{
  margin:auto 0;font-family:var(--serif);font-size:18px;line-height:1.75;color:#eee8dc;
  white-space:pre-wrap;display:-webkit-box;-webkit-line-clamp:12;-webkit-box-orient:vertical;overflow:hidden;
}
.ai-share-foot{font-size:9.5px;color:var(--muted-2);display:flex;justify-content:space-between;gap:10px;}
.ai-share-actions{display:grid;grid-template-columns:1fr 1fr;gap:8px;margin-top:12px;}
.ai-share-actions button{border:1px solid rgba(255,255,255,.09);border-radius:12px;padding:11px 8px;background:rgba(255,255,255,.035);color:var(--white);font:inherit;font-size:10.5px;cursor:pointer;}
.ai-share-actions button.primary{border-color:rgba(215,180,106,.22);background:rgba(215,180,106,.08);color:var(--gold-hi);}
.ai-share-close{width:100%;margin-top:8px;border:0;background:transparent;color:var(--muted-2);padding:8px;font:inherit;font-size:10px;cursor:pointer;}
</style>


<style id="ai-paywall-conversion-style">
.ai-chat-conversion-chooser{display:flex!important;flex-direction:column!important;gap:8px!important;padding:13px!important;border:1px solid rgba(215,180,106,.16);border-radius:17px;background:rgba(10,10,9,.92);}
.ai-paywall-head{padding:2px 2px 7px;}
.ai-paywall-kicker{font-size:9px;letter-spacing:.16em;color:var(--gold);margin-bottom:5px;}
.ai-paywall-head>b{display:block;font-family:var(--serif);font-size:16px;font-weight:400;color:var(--white);line-height:1.45;}
.ai-paywall-head>span{display:block;margin-top:5px;color:var(--muted-2);font-size:9.8px;line-height:1.55;}
.ai-chat-conversion-chooser .ai-chat-offer-card{position:relative;width:100%;display:flex!important;align-items:center;justify-content:space-between;gap:10px;text-align:left;padding:12px!important;border-radius:13px!important;}
.ai-offer-copy{display:flex;flex-direction:column;min-width:0;}
.ai-offer-copy small{font-size:8.8px;color:var(--muted-2);margin-bottom:3px;}
.ai-offer-copy b{font-size:12px!important;color:var(--white);}
.ai-offer-copy span{font-size:9px!important;color:var(--muted-2);margin-top:3px;}
.ai-offer-price{display:flex;flex-direction:column;align-items:flex-end;flex:0 0 auto;}
.ai-offer-price s{font-size:8.5px;color:var(--muted-2);}
.ai-offer-price em{font-style:normal;font-size:13px!important;color:var(--gold-hi);margin-top:2px;}
.ai-offer-best{border-color:rgba(215,180,106,.35)!important;background:rgba(215,180,106,.08)!important;padding-top:18px!important;}
.ai-offer-badge{position:absolute;top:-7px;right:10px;padding:3px 7px;border-radius:999px;background:#cdb06e;color:#111;font-size:7.8px;font-weight:700;letter-spacing:.04em;}
.ai-offer-premium{margin-top:2px;background:rgba(255,255,255,.035)!important;}
.ai-paywall-note{text-align:center;color:var(--muted-2);font-size:8.5px;line-height:1.5;padding:2px 4px 0;}
</style>


<style id="signup-conversion-ab-style">
.auth-free-benefit{margin:-2px 0 16px;padding:13px 14px;border:1px solid rgba(201,162,39,.28);border-radius:14px;background:rgba(201,162,39,.07);text-align:center}
.auth-free-benefit b{display:block;font-size:14px;line-height:1.45}
.auth-free-benefit span{display:block;margin-top:4px;font-size:11px;color:var(--muted)}
.home-free-value{text-align:center;margin:16px 0 9px}
.home-free-value b{display:block;font-size:16px;line-height:1.45}
.home-free-value span{display:block;margin-top:5px;font-size:12px;color:var(--muted)}
#homeGuestHint b{font-size:13px}
#homeGuestHint span{font-size:11px}
.home-free-value{margin:12px 0 8px}
.home-free-value b{font-size:15px}
.home-free-value span{font-size:10.5px;line-height:1.5}
.auth-free-benefit span{line-height:1.55}
@media(max-width:640px){.home-free-value b{font-size:14.5px}.auth-free-benefit{margin-bottom:13px}}
</style>

<style id="today-fortune-ai-question-style">
.today-fortune-ai-questions{display:grid;gap:7px;margin-top:10px}
.today-fortune-ai-questions button{width:100%;display:flex;align-items:center;gap:9px;padding:11px 12px;border:1px solid rgba(231,199,125,.18);border-radius:12px;background:rgba(255,255,255,.035);color:#eee8da;font-family:inherit;text-align:left;cursor:pointer;transition:.2s ease}
.today-fortune-ai-questions button:hover{border-color:rgba(231,199,125,.38);background:rgba(231,199,125,.08);transform:translateY(-1px)}
.today-fortune-ai-questions button span{font-size:15px;flex:0 0 auto}
.today-fortune-ai-questions button b{font-size:12px;font-weight:500;flex:1}
.today-fortune-ai-questions button i{font-style:normal;color:var(--gold-hi);opacity:.8}
.today-fortune-direct-ai{width:100%;margin-top:8px;padding:10px 12px;border:1px solid rgba(255,255,255,.10);border-radius:12px;background:transparent;color:var(--muted);font-family:inherit;font-size:11px;cursor:pointer}
.today-fortune-direct-ai:hover{color:#f3dfad;border-color:rgba(231,199,125,.26)}
</style>


<style id="seo-core-guides-style">
.seo-core-guides{padding:34px 18px 64px;background:transparent}
.seo-core-guides-inner{max-width:920px;margin:0 auto}
.seo-core-guides-kicker{font-size:10px;letter-spacing:.18em;font-weight:800;color:#b8924f;margin-bottom:10px}
.seo-core-guides h2{margin:0;color:inherit;font-family:Georgia,"Noto Serif KR",serif;font-size:clamp(25px,4vw,34px);font-weight:500;line-height:1.3}
.seo-core-guides-lead{margin:12px 0 22px;color:var(--muted,#8f8a82);font-size:14px;line-height:1.75}
.seo-core-guide-grid{display:grid;grid-template-columns:repeat(5,minmax(0,1fr));gap:10px}
.seo-core-guide-card{display:flex;min-height:142px;flex-direction:column;padding:18px 16px;border:1px solid rgba(184,146,79,.18);border-radius:18px;background:rgba(255,255,255,.025);text-decoration:none;color:inherit;transition:transform .18s ease,border-color .18s ease,background .18s ease}
.seo-core-guide-card:hover{transform:translateY(-2px);border-color:rgba(184,146,79,.42);background:rgba(184,146,79,.055)}
.seo-core-guide-card strong{font-size:16px;margin-bottom:8px}
.seo-core-guide-card span{font-size:12px;line-height:1.55;color:var(--muted,#8f8a82)}
.seo-core-guide-card em{margin-top:auto;padding-top:13px;color:#b8924f;font-size:12px;font-style:normal;font-weight:800}
@media(max-width:820px){.seo-core-guide-grid{grid-template-columns:repeat(2,minmax(0,1fr))}}
@media(max-width:520px){.seo-core-guides{padding:24px 16px 48px}.seo-core-guide-grid{grid-template-columns:1fr}.seo-core-guide-card{min-height:112px}}
</style>

<style id="home-ai-chat-cue-position-fix">
/* 홈 스크롤 안내: 문구 없이 화살표만 AI Chat 상단에 표시 */
.home-more-cue{
  bottom:auto !important;
  top:50% !important;
  transform:translate(-50%,-50%) !important;
  min-height:34px !important;
  padding:4px 12px !important;
  gap:0 !important;
}
.home-more-label{display:none !important;}
</style>
<style id="mobile-ai-keyboard-fix">
@media (max-width: 820px) {
  /* iOS Safari: 16px 미만 입력창 포커스 시 자동 확대 방지 */
  #aiChatInput {
    font-size: 16px !important;
    line-height: 1.45 !important;
  }

  /* 키보드가 열린 동안 채팅 패널을 실제 보이는 viewport 안에 고정 */
  body.ai-keyboard-open {
    overflow: hidden !important;
  }
  body.ai-keyboard-open #aiChatPanel {
    position: fixed !important;
    left: 0 !important;
    right: 0 !important;
    top: var(--ai-vv-top, 0px) !important;
    height: var(--ai-vv-height, 100dvh) !important;
    max-height: var(--ai-vv-height, 100dvh) !important;
    margin: 0 !important;
    transform: none !important;
  }
  body.ai-keyboard-open #aiChatWindow {
    min-height: 0 !important;
    overflow-y: auto !important;
    overscroll-behavior: contain;
    -webkit-overflow-scrolling: touch;
    padding-bottom: 10px !important;
  }
  body.ai-keyboard-open .ai-chat-inputrow {
    position: relative !important;
    z-index: 50 !important;
    flex: 0 0 auto !important;
    background: rgba(7,7,6,.98) !important;
    padding-bottom: max(8px, env(safe-area-inset-bottom)) !important;
  }
}
</style>
<link rel="preconnect" href="https://accounts.google.com">
<link rel="preconnect" href="https://www.googleapis.com">
<link rel="preconnect" href="https://kauth.kakao.com">
