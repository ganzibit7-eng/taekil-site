<style id="legal-detail-expanded-style">
.legal-detail-section{max-width:900px;margin:0 auto;padding:34px 22px 12px;scroll-snap-align:none!important;min-height:auto!important;height:auto!important}
.legal-detail-section h2{margin:6px 0 20px;font-size:25px}.legal-detail-section .legal-block{padding:20px 22px}
.legal-detail-section .legal-block h3{margin:22px 0 7px;color:#f0d99e;font-size:14px;line-height:1.5}.legal-detail-section .legal-block h3:first-child{margin-top:0}
.legal-detail-section .legal-block p{margin:0;color:var(--muted);font-size:12px;line-height:1.85;word-break:keep-all}
@media(max-width:640px){.legal-detail-section{padding:26px 15px 8px}.legal-detail-section h2{font-size:21px}.legal-detail-section .legal-block{padding:16px 15px}.legal-detail-section .legal-block h3{font-size:13px}.legal-detail-section .legal-block p{font-size:11.5px;line-height:1.8}}
</style>

<style id="admin-dashboard-accordion-style">
.admin-fold{margin:18px 0 0;border:1px solid rgba(255,255,255,.09);border-radius:18px;background:rgba(255,255,255,.018);overflow:hidden}
.admin-fold-toggle{width:100%;display:flex;align-items:center;justify-content:space-between;gap:14px;padding:17px 18px;background:transparent;border:0;color:inherit;font:inherit;text-align:left;cursor:pointer}
.admin-fold-toggle:hover{background:rgba(255,255,255,.025)}
.admin-fold-title{display:flex;flex-direction:column;gap:3px}
.admin-fold-title small{font-size:9px;letter-spacing:.16em;color:var(--gold);font-weight:800}
.admin-fold-title b{font-size:17px;color:var(--white)}
.admin-fold-chevron{font-size:19px;color:var(--muted-2);transition:transform .2s ease}
.admin-fold.open .admin-fold-chevron{transform:rotate(180deg)}
.admin-fold-body{display:none;padding:0 18px 18px}
.admin-fold.open .admin-fold-body{display:block}
.admin-fold-body > .section-head:first-child{margin-top:4px!important}
@media(max-width:640px){.admin-fold-toggle{padding:15px}.admin-fold-body{padding:0 14px 15px}.admin-fold-title b{font-size:15px}}
</style>


<style id="admin-fold-toolbar-style">






.admin-fold-shortcuts{display:flex;gap:6px;overflow-x:auto;padding-top:9px;scrollbar-width:none}
.admin-fold-shortcuts::-webkit-scrollbar{display:none}.admin-fold-shortcuts button{white-space:nowrap}
.admin-fold-toggle:focus-visible,.admin-menu-overview button:focus-visible{outline:2px solid rgba(215,180,106,.65);outline-offset:2px}
@media(max-width:640px){.admin-fold-toolbar-actions button{padding:6px 7px;font-size:9px}}
</style>


<style id="admin-overview-card-cleanup">
/* 관리자 운영현황에서는 요청한 두 카드만 비표시. 데이터 로직은 그대로 보존. */
#adminKakaoSignupCard,
#adminRecent7dCard{display:none!important}
</style>


<style id="admin-menu-overview-style">
.admin-menu-overview{margin:12px 0 16px;display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:8px}
.admin-menu-overview button{min-height:54px;padding:10px 11px;border:1px solid rgba(255,255,255,.10);border-radius:13px;background:rgba(255,255,255,.025);color:var(--white);font:inherit;font-size:11px;font-weight:700;cursor:pointer;text-align:left}
.admin-menu-overview button small{display:block;margin-bottom:3px;color:var(--gold);font-size:8px;letter-spacing:.12em}
.admin-menu-overview button:hover{background:rgba(215,180,106,.08);border-color:rgba(215,180,106,.35)}
.admin-fold{scroll-margin-top:150px}
@media(max-width:640px){.admin-menu-overview{grid-template-columns:repeat(2,minmax(0,1fr));gap:7px}.admin-menu-overview button{min-height:50px;font-size:10.5px}}
</style>


<style id="admin-exclusive-mode-style">
html.admin-exclusive-mode,html.admin-exclusive-mode body{
  scroll-snap-type:none!important;
  overflow-y:auto!important;
}
body.admin-exclusive-mode > *:not(#app):not(script):not(style),
body.admin-exclusive-mode #app > *:not(#view-admin){
  display:none!important;
}
body.admin-exclusive-mode #view-admin{
  display:block!important;
  min-height:100vh!important;
  height:auto!important;
  overflow:visible!important;
  scroll-snap-align:none!important;
  padding-top:20px!important;
}
body.admin-exclusive-mode #view-admin .admin-wrap,
body.admin-exclusive-mode #view-admin .container{
  width:min(100% - 28px,1100px)!important;
  max-width:1100px!important;
  margin:0 auto!important;
}

/* 관리자 헤더 */
body.admin-exclusive-mode #view-admin .admin-page-title,
body.admin-exclusive-mode #view-admin > .section-head:first-child{
  margin:0 0 14px!important;
}

/* 관리자 전체 메뉴: 동일 크기/간격 */
body.admin-exclusive-mode .admin-menu-overview{
  display:grid!important;
  grid-template-columns:repeat(3,minmax(0,1fr))!important;
  gap:10px!important;
  margin:0 0 16px!important;
}
body.admin-exclusive-mode .admin-menu-overview button{
  min-width:0!important;
  min-height:68px!important;
  padding:12px 14px!important;
  border-radius:14px!important;
  display:flex!important;
  flex-direction:column!important;
  justify-content:center!important;
  gap:3px!important;
  line-height:1.35!important;
  box-sizing:border-box!important;
}

/* 빠른 메뉴/전체 접기 영역 */

/* 모든 접이식 메뉴의 폭·여백·제목 높이를 통일 */
body.admin-exclusive-mode .admin-fold{
  margin:10px 0 0!important;
  border-radius:16px!important;
}
body.admin-exclusive-mode .admin-fold-toggle{
  min-height:64px!important;
  padding:14px 16px!important;
}
body.admin-exclusive-mode .admin-fold-body{
  padding:0 16px 16px!important;
}
body.admin-exclusive-mode #adminTrafficSourceCard{
  width:100%!important;
  min-height:64px!important;
  margin:10px 0 0!important;
  border-radius:16px!important;
  box-sizing:border-box!important;
}

/* 관리자 안의 일반 섹션 간격 정리 */
body.admin-exclusive-mode #view-admin .section-head{
  margin-top:18px!important;
  margin-bottom:12px!important;
}
body.admin-exclusive-mode #view-admin .admin-stats{
  gap:10px!important;
}
body.admin-exclusive-mode #view-admin .admin-table-wrap,
body.admin-exclusive-mode #view-admin .admin-list,
body.admin-exclusive-mode #view-admin .admin-ban-section{
  margin-top:10px!important;
}

/* 혹시 관리자 DOM 안에 남아 있는 일반 사용자용 가이드/SEO/footer 요소는 숨김 */
body.admin-exclusive-mode #view-admin .seo-core-guides,
body.admin-exclusive-mode #view-admin [class*="seo-guide"],
body.admin-exclusive-mode #view-admin [id*="seo-guide"],
body.admin-exclusive-mode #view-admin .home-guide,
body.admin-exclusive-mode #view-admin [class*="user-guide"],
body.admin-exclusive-mode #view-admin footer{
  display:none!important;
}

@media(max-width:760px){
  body.admin-exclusive-mode #view-admin{padding-top:12px!important}
  body.admin-exclusive-mode #view-admin .admin-wrap,
  body.admin-exclusive-mode #view-admin .container{width:min(100% - 20px,1100px)!important}
  body.admin-exclusive-mode .admin-menu-overview{grid-template-columns:repeat(2,minmax(0,1fr))!important;gap:8px!important}
  body.admin-exclusive-mode .admin-menu-overview button{min-height:60px!important;padding:10px 11px!important}

  body.admin-exclusive-mode .admin-fold-toggle{min-height:58px!important;padding:12px 14px!important}
  body.admin-exclusive-mode .admin-fold-body{padding:0 13px 14px!important}
}
</style>


<style id="admin-performance-ui-fix">
body.admin-exclusive-mode .admin-fold-toolbar,
body.admin-exclusive-mode .admin-menu-overview,
body.admin-exclusive-mode .admin-fold{
  backdrop-filter:none!important;
  -webkit-backdrop-filter:none!important;
}
body.admin-exclusive-mode #view-admin{
  contain:layout style;
}
body.admin-exclusive-mode .admin-fold:not(.open) .admin-fold-body{
  display:none!important;
}
body.admin-exclusive-mode .admin-fold.open .admin-fold-body{
  display:block!important;
}
@media(max-width:760px){
  body.admin-exclusive-mode #view-admin *{
    scroll-behavior:auto!important;
  }
}
</style>

